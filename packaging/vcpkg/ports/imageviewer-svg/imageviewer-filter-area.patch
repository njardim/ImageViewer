+fn render_reduced(
+    group: &usvg::Group,
+    ctx: &Context,
+    transform: tiny_skia::Transform,
+    ibbox: tiny_skia::IntRect,
+    reach: Option<u32>,
+    factors: (u32, u32),
+    pixmap: &mut tiny_skia::PixmapMut,
+) -> Option<()> {
+    let cells = |size: u32, factor: u32| ((f64::from(size) / f64::from(factor)).round() as u32).clamp(1, size);
+    let (width, height) = (cells(ibbox.width(), factors.0), cells(ibbox.height(), factors.1));
+    let (sx, sy) = (width as f32 / ibbox.width() as f32, height as f32 / ibbox.height() as f32);
+    let small_ts = tiny_skia::Transform::from_scale(sx, sy).pre_concat(transform);
+    let mut small = tiny_skia::Pixmap::new(width, height)
+        .log_none(|| log::warn!("Failed to allocate a group layer for: {:?}.", ibbox))?;
+    let layer = tiny_skia::IntRect::from_xywh(0, 0, width, height)?;
+    let visible = match reach {
+        Some(reach) => crate::geom::expand(ctx.visible, reach),
+        None => ibbox,
+    }
+    .translate(-ibbox.x(), -ibbox.y())
+    .and_then(|area| {
+        tiny_skia::IntRect::from_ltrb(
+            (area.left() as f32 * sx).floor() as i32,
+            (area.top() as f32 * sy).floor() as i32,
+            (area.right() as f32 * sx).ceil() as i32,
+            (area.bottom() as f32 * sy).ceil() as i32,
+        )
+    })
+    .and_then(|area| crate::geom::fit_to_rect(area, layer))
+    .unwrap_or(layer);
+    let small_ctx = Context {
+        max_bbox: ctx.max_bbox,
+        visible,
+        filter_cache: ctx.filter_cache.clone(),
+    };
+    render_nodes(group, &small_ctx, small_ts, &mut small.as_mut());
+    for filter in group.filters() {
+        crate::filter::apply(filter, small_ts, &ctx.filter_cache, &mut small);
+    }
+
+    // Enlarged within the filter's region, at full resolution: its edge stays sharp.
+    let region = group.filters()[0].rect().transform(transform)?.to_int_rect();
+    let region = crate::geom::fit_to_rect(
+        region,
+        tiny_skia::IntRect::from_xywh(0, 0, ibbox.width(), ibbox.height())?,
+    )?
+    .translate(ibbox.x(), ibbox.y())?;
+    let paint = tiny_skia::Paint {
+        shader: tiny_skia::Pattern::new(
+            small.as_ref(),
+            tiny_skia::SpreadMode::Pad,
+            tiny_skia::FilterQuality::Bilinear,
+            group.opacity().get(),
+            tiny_skia::Transform::from_row(1.0 / sx, 0.0, 0.0, 1.0 / sy, ibbox.x() as f32, ibbox.y() as f32),
+        ),
+        blend_mode: convert_blend_mode(group.blend_mode()),
+        anti_alias: false,
+        ..tiny_skia::Paint::default()
+    };
+    pixmap.fill_rect(region.to_rect(), &paint, tiny_skia::Transform::identity(), None);
+    Some(())
+}
