+/// About how many times smaller on each axis `filters` may be computed under `ts`, as Skia (and so
+/// Chromium) blurs: a lone blur of every input pixel (`SourceGraphic` or `SourceAlpha`) over the
+/// whole filter region, whose sigma passes 4 pixels, on a layer smaller by blur_reduction() with a
+/// sigma of at most 4 there, enlarged afterwards. The result differs from the exact one by much less
+/// than what the blur spreads; at large sigmas it costs a small fraction of the time and memory.
+/// None: the exact way.
+pub fn reduction(filters: &[std::sync::Arc<usvg::filter::Filter>], ts: tiny_skia::Transform) -> Option<(u32, u32)> {
+    let [filter] = filters else {
+        return None;
+    };
+    let [primitive] = filter.primitives() else {
+        return None;
+    };
+    let usvg::filter::Kind::GaussianBlur(fe) = primitive.kind() else {
+        return None;
+    };
+    if matches!(fe.input(), usvg::filter::Input::Reference(_)) || primitive.rect() != filter.rect() {
+        return None;
+    }
+    let (x, y, _) = resolve_std_dev(fe.std_dev_x().get(), fe.std_dev_y().get(), ts)?;
+    let factors = (blur_reduction(x), blur_reduction(y));
+    (factors.0 * factors.1 > 1).then_some(factors)
