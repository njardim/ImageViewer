+
+/// `r` grown by `by` on every side, within the coordinates an `IntRect` can hold.
+pub fn expand(r: tiny_skia::IntRect, by: u32) -> tiny_skia::IntRect {
+    const LIMIT: i64 = (i32::MAX / 2) as i64;
+    let by = i64::from(by);
+    let side = |v: i32, d: i64| (i64::from(v) + d).clamp(-LIMIT, LIMIT) as i32;
+    tiny_skia::IntRect::from_ltrb(
+        side(r.left(), -by),
+        side(r.top(), -by),
+        side(r.right(), by),
+        side(r.bottom(), by),
+    )
+    .unwrap_or(r)
+}
