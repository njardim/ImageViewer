+/// How far, in pixels, `filters` reach under `ts`: a pixel of their result depends only on the
+/// pixels of their input at most this far away. None when it may depend on the whole filter region:
+/// `feTile` repeats a part of it, `feImage` and stitched `feTurbulence` are fitted to it.
+pub fn reach(filters: &[std::sync::Arc<usvg::filter::Filter>], ts: tiny_skia::Transform) -> Option<u32> {
+    use usvg::filter::Kind;
+
+    let (sx, sy) = ts.get_scale();
+    let scale = f64::from(sx.max(sy));
+    let blur = |x: usvg::PositiveF32, y: usvg::PositiveF32| match resolve_std_dev(x.get(), y.get(), ts) {
+        Some((x, y, true)) => f64::from(box_blur::reach(x).max(box_blur::reach(y))),
+        // The IIR blur (sigma < 2) has no end: its tail past 6 sigma is far below one level.
+        Some((x, y, false)) => 6.0 * x.max(y) + 2.0,
+        None => 0.0,
+    };
+    let offset = |dx: f32, dy: f32| f64::from(dx.abs().max(dy.abs())) * scale + 1.0;
+    let mut total = 1.0; // the rounding of regions to pixels
+    for filter in filters {
+        for primitive in filter.primitives() {
+            total += match primitive.kind() {
+                Kind::GaussianBlur(fe) => blur(fe.std_dev_x(), fe.std_dev_y()),
+                Kind::DropShadow(fe) => blur(fe.std_dev_x(), fe.std_dev_y()) + offset(fe.dx(), fe.dy()),
+                Kind::Offset(fe) => offset(fe.dx(), fe.dy()),
+                Kind::Morphology(fe) => f64::from(fe.radius_x().get().max(fe.radius_y().get())) * scale,
+                Kind::DisplacementMap(fe) => f64::from(fe.scale().abs()) / 2.0 * scale,
+                Kind::ConvolveMatrix(fe) => f64::from(fe.matrix().columns().max(fe.matrix().rows())),
+                Kind::DiffuseLighting(_) | Kind::SpecularLighting(_) => 2.0,
+                Kind::Tile(_) | Kind::Image(_) => return None,
+                Kind::Turbulence(fe) if fe.stitch_tiles() => return None,
+                _ => 0.0,
+            };
+        }
+    }
+    (total < f64::from(u32::MAX)).then(|| total.ceil() as u32)
+}
