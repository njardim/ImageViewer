+/// How far the box blur of `sigma` pixels reaches (box_blur::reach()); reduced (blur()), through the
+/// reduced pixels each `factor` pixels wide and the interpolation between two of them.
+fn blur_reach(sigma: f64) -> u32 {
+    match blur_reduction(sigma) {
+        1 => box_blur::reach(sigma),
+        factor => (box_blur::reach(sigma / f64::from(factor)) + 2).saturating_mul(factor),
+    }
+}
 
