+/// How many times smaller an axis with a blur of `sigma` pixels is blurred, as Skia blurs: halved
+/// while the sigma passes 4 pixels.
+fn blur_reduction(sigma: f64) -> u32 {
+    let (mut sigma, mut factor) = (sigma, 1);
+    while sigma > 4.0 && factor < 1 << 12 {
+        sigma /= 2.0;
+        factor *= 2;
+    }
+    factor
+}
 
+/// The source pixels each of `cells` cells averages, `size` pixels spread evenly over them: (pixel,
+/// weight) pairs, the weights of a cell summing to 1.
+fn spans(size: usize, cells: usize) -> Vec<Vec<(usize, f32)>> {
+    let scale = size as f64 / cells as f64;
+    (0..cells)
+        .map(|i| {
+            let (start, end) = (i as f64 * scale, (i + 1) as f64 * scale);
+            (start.floor() as usize..(end.ceil() as usize).min(size))
+                .map(|p| (p, ((end.min(p as f64 + 1.0) - start.max(p as f64)) / scale) as f32))
+                .filter(|&(_, weight)| weight > 0.0)
+                .collect()
+        })
+        .collect()
+}
